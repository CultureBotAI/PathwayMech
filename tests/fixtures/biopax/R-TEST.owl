<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <bp:Pathway rdf:ID="pathway">
    <bp:displayName>Mini BioPAX glycolysis</bp:displayName>
    <bp:pathwayComponent rdf:resource="#reaction" />
    <bp:xref rdf:resource="#publication" />
  </bp:Pathway>
  <bp:BiochemicalReaction rdf:ID="reaction">
    <bp:displayName>phosphoglycerate mutase reaction</bp:displayName>
    <bp:left rdf:resource="#three_pga" />
    <bp:right rdf:resource="#two_pga" />
    <bp:xref rdf:resource="#publication" />
  </bp:BiochemicalReaction>
  <bp:SmallMolecule rdf:ID="three_pga">
    <bp:displayName>3-phosphonato-D-glycerate(3-)</bp:displayName>
    <bp:entityReference rdf:resource="#three_pga_reference" />
  </bp:SmallMolecule>
  <bp:SmallMolecule rdf:ID="two_pga">
    <bp:displayName>2-phosphonato-D-glycerate(3-)</bp:displayName>
    <bp:entityReference rdf:resource="#two_pga_reference" />
  </bp:SmallMolecule>
  <bp:SmallMoleculeReference rdf:ID="three_pga_reference">
    <bp:xref rdf:resource="#three_pga_xref" />
  </bp:SmallMoleculeReference>
  <bp:SmallMoleculeReference rdf:ID="two_pga_reference">
    <bp:xref rdf:resource="#two_pga_xref" />
  </bp:SmallMoleculeReference>
  <bp:UnificationXref rdf:ID="three_pga_xref">
    <bp:db>ChEBI</bp:db>
    <bp:id>CHEBI:58272</bp:id>
  </bp:UnificationXref>
  <bp:UnificationXref rdf:ID="two_pga_xref">
    <bp:db>ChEBI</bp:db>
    <bp:id>CHEBI:58289</bp:id>
  </bp:UnificationXref>
  <bp:PublicationXref rdf:ID="publication">
    <bp:id>12345678</bp:id>
  </bp:PublicationXref>
</rdf:RDF>
