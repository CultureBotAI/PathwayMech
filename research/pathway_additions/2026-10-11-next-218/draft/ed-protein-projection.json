                "id": "31390539"
              }
            ],
            "value": "Cells lacking this gene show no detectable KHG aldolase activity (PubMed:1339418). Does not affect growth on glucose and native reaction flux (PubMed:31390539)"
          }
        ],
        "commentType": "DISRUPTION PHENOTYPE"
      },
      {
        "texts": [
          {
            "evidences": [
              {
                "evidenceCode": "ECO:0000269",
