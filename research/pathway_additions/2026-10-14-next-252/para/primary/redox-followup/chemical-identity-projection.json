  "decisions": [
    {
      "id": "CHEBI:30060",
      "decision": "The paper explicitly names K3FE(CN)6, so use the potassium salt. CHEBI:5020 is the ferricyanide anion and is not silently substituted for the stated neutral salt reagent. No role for free cyanide is asserted."
    },
    {
      "id": "CHEBI:22651",
      "decision": "Abstract specifies ascorbate without stereochemistry. Use the generic ChEBI chemical entity; neither source resolves one structure for this class. CHEBI:38290 is its narrower L-enantiomer child and is not asserted."
    },
    {
      "id": "CHEBI:16240",
      "decision": "H2O2 is the exact neutral hydrogen peroxide species; do not substitute hydroperoxide anion or oxygen."
    }
  ]
