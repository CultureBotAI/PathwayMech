  "source_fact_dispositions": [
    {
      "source": "MONOMER-13716 / MONOMER-13717",
      "disposition": "Reverse native UniProt cross-references rejected. Original AF461116 translations, product fields and primary N-terminal sequences assign A4YD22 carboxylase and A4YD23 carrier."
    },
    {
      "source": "BIOTIN-CARBOXYL-RXN / RXN0-5055 carrier names",
      "disposition": "Exact native half-reaction sum used. Generic bacterial BCCP-dimer carrier identity is not assigned to the archaeal subunit. All charge and small-molecule terms remain in independently issued net RHEA11309."
    },
    {
      "source": "CPLX-8531 / CPLX-8532",
      "disposition": "Nested coefficients do not establish total monomer count, and 8531 has no informative canonical HTML name. Primary alpha2beta2 assembly used for verified CPLX7576; no alpha4beta4 multiplication."
    },
    {
      "source": "MONOMER-13730 / ENZRXN-14671",
      "disposition": "Native catalyst is S. tokodaii Q975C8. Selected Msed1426 is grounded by native peptide identification, original full UniProt and later direct recombinant experiment PMID27771364."
    },
    {
      "source": "UniProt A4YGN0 catalytic annotation",
      "disposition": "Current acetylating-dehydrogenase reaction conflicts with direct Msed1424 succinic semialdehyde reduction and native CPLX7948; not used as activity evidence."
    },
    {
      "source": "Native ENZRXN14679/14680 Msed0399-only activity assignment",
      "disposition": "Measured alternative retained, but 2020 and 2021 full primaries establish Msed1423 and Msed2001 as principal activities."
    },
    {
      "source": "Msed0394/0336/0384/0389",
      "disposition": "Measured alternatives retained as functional enables with limited physiological contribution; no equal flux or obligatory membership inferred."
    },
    {
      "source": "Msed1422/1220/0566/0385 and Msed1353 W424G",
      "disposition": "Historical candidates, weak activity or engineered substrate specificity do not establish them as principal natural cycle enzymes. Msed0566 primary2021 weak activity does not supersede measured Msed2001 predominance."
    },
    {
      "source": "PMID27771364, Results S13/S15",
      "disposition": "Msed2001 octamer differs from older monomer; Msed1424 pentamer differs from older dimer. Both preparation-specific observations are retained without inferring the cause or universal assembly."
    },
    {
      "source": "PMID27771364, Results S12/S14",
      "disposition": "HPCS/HPCD positive yeast two-hybrid and recombinant (HPCS)4(HPCD)8 association are retained in catalytic-edge context; no external whole-assembly ID was verified, so no invented complex. ACR/SSR coexpression aids solubility but two-hybrid assay was negative."
    },
    {
      "source": "PMID27771364, Methods S4 versus Results S17",
      "disposition": "Methods name Msed0709; Results name Msed0745, and cite the earlier S. tokodaii preparation protocol. This source identity discrepancy prevents using its MCR rate as an unqualified exact Msed0709 construct measurement. Earlier native peptide/functional evidence remains."
    },
    {
      "source": "PMID25939834, Results experimental HhcR validation",
      "disposition": "Direct binding used M. yellowstonensis H2C8P4. M. sedula Msed2175 and its targets are comparative-genomic predictions reconciled with omics, not direct selected-strain binding proof. Retained contextual regulatory lead; no new experimental regulatory edges."
    },
    {
      "source": "PMID39019246 abstract",
      "disposition": "Current 2024 Rhea-linked kinetic paper concerns the C-terminal domain of the distinct Chloroflexus bifunctional malonyl-CoA reductase; not transferred to the archaeal enzyme."
    },
    {
      "source": "PWY5789 species / global reaction enzymatic-reaction lists",
      "disposition": "Scope is selected experimentally supported TH2. Shared reaction annotations for other taxa and the distinct DC/HB cycle are not inherited as unconditional catalysts/taxa of this record."
    },
    {
      "source": "Native summary after crotonyl-CoA",
      "disposition": "Repeated 4-hydroxybutyryl-CoA name corrected using exact native reaction objects and primary (S)-3-hydroxybutyryl-CoA assays; complete route retained."
    },
    {
      "source": "Native or automatic cofactors",
      "disposition": "Direct biotin/Zn/divalent activation and B12 evidence retained; ACR zinc and ligase Mg/Mn remain similarity-based. A4YD22 automatic cobalt assignment does not replace primary magnesium-dependent carboxylase data. NAD(P) cofactors already represented as substrates are not duplicated as obligatory bound groups."
    }
  ],
