  "dispositions": [
    {
      "source_fact": "Five native activation members",
      "disposition": "All retained, with all23Rhea chemical sides and coefficients."
    },
    {
      "source_fact": "MetaCyc BTUR2-RXN / Rhea14726 composite",
      "disposition": "Mechanism bridge only; excluded as an additional graph reaction to prevent double counting. 2\u00d7binding + reduction +2\u00d7adenosyl transfer yields the Rhea net."
    },
    {
      "source_fact": "Native RXN19338 2H+ / Rhea57693 3H+",
      "disposition": "Coherent Rhea142 reactive-part charge forms retained; old native coefficient not silently copied."
    },
    {
      "source_fact": "Native RXN19343 coefficients2 / Rhea57697 coefficients1",
      "disposition": "Different equation scaling explicitly preserved."
    },
    {
      "source_fact": "Native CPD20903/20906/20907",
      "disposition": "Fresh native names verify free cobII and bound cobII/cobI. The pathway prose calling generic cobinamide cobI does not override reaction-layout inputCPD20903."
    },
    {
      "source_fact": "ECOLI COBU-CPLX",
      "disposition": "Verified2\u00d7P0AE76 and two activities with HINF/complementation evidence; not mislabeled as a MetaCyc identifier (META frame404). Retained as assembly context; exact PathBank role/location objects used as graph IDs."
    },
    {
      "source_fact": "PathBank3868/3869_Cytosol",
      "disposition": "Both source projections retained with2\u00d7P0AE76 membership and their respective catalytic edges. Not two asserted enzyme species and no sameAs inference. Only3869 has explicit cytosol edge."
    },
    {
      "source_fact": "PathBank5141 copied kinase EC/display label",
      "disposition": "Its GTP/AdoCbi-P\u2192AdoCbi-GDP/PPi chemical sides and current UniProt/Rhea establish guanylyltransferase; copied EC2.7.1.156 is not propagated."
    },
    {
      "source_fact": "BtuR exact cobinamide assignment",
      "disposition": "Verified ECOLI protein\u2192BTUR2-ENZRXN\u2192BTUR2-RXN and UniProtP0A9H5 crosswalk, HINF evidence. Functional enables on adenosyl-transfer component is qualified inference, not direct Ecoli assay/monomer sufficiency."
    },
    {
      "source_fact": "Anaerobic btuR bypass",
      "disposition": "Preserved from1995 K12 primary growth genetics; no universal BtuR essentiality."
    },
    {
      "source_fact": "Rhea whole ETF and bound corrinoid states",
      "disposition": "All5generic polypeptide states retained. No substitution with free FAD/FADH2 or identification of an in vivo donor."
    },
    {
      "source_fact": "GTP kinase alternative15765",
      "disposition": "Supported by reviewed CobU but outside selected native ATP-member route. Not asserted absent biologically."
    },
    {
      "source_fact": "Cobalt and Mg2+",
      "disposition": "Cobalt remains within substrate chemistry. No unsupported free-metal cofactor edge or inference from MgATP."
    },
    {
      "source_fact": "PathBank transport, denovo branches, PWY5509",
      "disposition": "Outside exact PWY7971 boundary; fullCOBALSYN and late nucleotide-loop assembly not claimed covered."
    },
    {
      "source_fact": "SalmonellaCPLX7418/CPLX7420, MethanosarcinaMONOMER14887",
      "disposition": "Not Ecoli enzyme/assembly identities; not transferred from label similarity."
    }
  ]
}
