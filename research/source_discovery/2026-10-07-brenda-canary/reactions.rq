PREFIX d3o: <https://purl.dsmz.de/schema/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?reaction ?predicate ?object WHERE { <https://purl.dsmz.de/brenda/pathway/76> d3o:hasReaction ?reaction . ?reaction ?predicate ?object } ORDER BY ?reaction ?predicate ?object LIMIT 1000
